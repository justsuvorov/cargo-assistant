# Пример настроек cargo-assistant. Скопируйте в .env (он в .gitignore) и заполните.
# Здесь только заглушки: настоящие ключи и адреса в git не попадают никогда.
# Переменные окружения процесса важнее значений из .env.

# --- База данных и хранилище ---
DATABASE_URL=sqlite+aiosqlite:///./cargo.db
STORAGE_DIR=./storage

# --- Модель: выбор провайдера ---
# vsk — шлюз ВСК в контуре (рабочий вариант, по умолчанию);
# anthropic, gemini — внешние сервисы только для разработки.
LLM_PROVIDER=vsk
# Внешние провайдеры — за пределами контура ВСК. Данные клиента (полисы, декларации,
# названия, ИНН, номера) туда отправлять НЕЛЬЗЯ — только обезличенные или вымышленные.
# Без true выбор anthropic или gemini останавливает запуск с ошибкой.
LLM_ALLOW_EXTERNAL=false

# --- Шлюз ВСК (LLM_PROVIDER=vsk), OpenAI-совместимый /v1/chat/completions ---
LLM_API_URL=https://gateway.example.invalid/v1/chat/completions
# Ключ шлюза: вставьте сюда или задайте переменной окружения / k8s secret
LLM_API_KEY=
LLM_MODEL=change-me
# Как просить JSON у шлюза: prompt (схема только в промпте), json_object,
# json_schema (response_format), guided_json (vLLM). Выбрать по итогам python -m app.llm probe
LLM_RESPONSE_FORMAT=prompt
# Бюджет рассуждений thinking_token_budget, токенов; 0 — поле не отправляется
LLM_THINKING_BUDGET=0

# --- Anthropic (LLM_PROVIDER=anthropic, нужен LLM_ALLOW_EXTERNAL=true) ---
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Глубина рассуждений: low, medium, high, xhigh, max; пусто — значение модели по умолчанию
ANTHROPIC_EFFORT=

# --- Gemini (LLM_PROVIDER=gemini, нужен LLM_ALLOW_EXTERNAL=true), OpenAI-совместимый endpoint ---
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_API_KEY=
# Имя модели из документации Google, например gemini-<версия>-flash
GEMINI_MODEL=

# --- Модель: общие ограничения для всех провайдеров ---
# Предел длины ответа, токенов
LLM_MAX_TOKENS=4096
# Сколько запросов к модели одновременно на процесс
LLM_MAX_CONCURRENCY=4
# Таймаут одного HTTP-запроса, с
LLM_TIMEOUT=60
# Общее время всех попыток одного ответа, включая повторы, с
LLM_TOTAL_TIMEOUT=300
# Попытки и пауза при сетевых ошибках, таймаутах, 429 и 5xx
LLM_RETRY_ATTEMPTS=5
LLM_RETRY_PAUSE=5
# Попытки и пауза, когда модель вернула пустой ответ (бюджет ушёл на рассуждения)
LLM_EMPTY_ATTEMPTS=3
LLM_EMPTY_PAUSE=1

# --- Модель: TLS ---
# Проверять сертификат сервера модели; false — только для отладки, в журнал пишется предупреждение
LLM_VERIFY_TLS=true
# Путь к PEM-сертификату корпоративного CA в дополнение к системным; пусто — только системные
LLM_CA_BUNDLE=

# --- Воркер ---
WORKER_MAX_JOBS=2
WORKER_POLL_INTERVAL=1.0
WORKER_JOB_TIMEOUT=600
WORKER_MAX_ATTEMPTS=3

# --- Вход через Keycloak ---
KEYCLOAK_URL=https://keycloak.example.invalid
KEYCLOAK_REALM=change-me
KEYCLOAK_CLIENT_ID=cargo-assistant
KEYCLOAK_ROLE_USER=cargo_user
KEYCLOAK_ROLE_EXPERT=cargo_expert
KEYCLOAK_ROLE_ADMIN=cargo_admin
# Режим разработки без Keycloak: пускает всех; в контуре всегда false
AUTH_DEV_MODE=false

# Тесты на Postgres: база из docker-compose.test.yml (только для тестов, данные в памяти контейнера)
# TEST_DATABASE_URL=postgresql+asyncpg://cargo:cargo@127.0.0.1:55432/cargo_test

# Мониторинг (D-34): сигнал воркера, очистка журнала, срок хранения, версии в журнале
WORKER_BEAT_INTERVAL=30
WORKER_PURGE_INTERVAL=86400
JOURNAL_RETENTION_MONTHS=3
# Версию кода задаёт сборка образа: --build-arg APP_VERSION=$(git rev-parse --short HEAD)
APP_VERSION=dev
CARDS_DIR=cards
PROMPTS_VERSION=
